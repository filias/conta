# Flask session signing key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Login password hash: uv run flask --app conta hash-password
ADMIN_PASSWORD_HASH=

# Secret path segment for your private calendar feed (/calendar/<token>.ics)
# python -c "import secrets; print(secrets.token_urlsafe(24))"
CALENDAR_TOKEN=

SITE_URL=https://conta.filias.dev
DATABASE_URL=sqlite:///conta.db
# Private guides + videos live here, outside git
PRIVATE_DIR=private
# Plain-HTTP local dev needs this off; production should set it to 1
SESSION_COOKIE_SECURE=0

# Email reminders (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=

# Push reminders via ntfy (optional), e.g. https://ntfy.sh/<long-random-topic>
NTFY_URL=
NTFY_TOKEN=
